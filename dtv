<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ChocoPop Flow - Player</title>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0a0a0a;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      font-family: 'Segoe UI', sans-serif;
      overflow: hidden;
    }

    .player-wrapper {
      position: relative;
      width: 100vw;
      height: 100vh;
      background: #000;
    }

    video {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    /* Logo bottom-left */
    .logo {
      position: absolute;
      bottom: 18px;
      left: 18px;
      width: 160px;
      opacity: 0.92;
      pointer-events: none;
      z-index: 10;
      filter: drop-shadow(0 2px 8px rgba(0,0,0,0.7));
    }

    /* Status overlay */
    .status {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: #fff;
      font-size: 1rem;
      background: rgba(0,0,0,0.6);
      padding: 10px 20px;
      border-radius: 8px;
      display: none;
      z-index: 20;
    }
  </style>
</head>
<body>
  <div class="player-wrapper">
    <video id="video" controls autoplay playsinline></video>
    <img
      class="logo"
      src="data:image/jpeg;base64,"
      alt="ChocoPop Flow"
    />
    <div class="status" id="status">Cargando stream...</div>
  </div>

  <script>
    const src = "https://dw5pdgvk.fubohd.com:443/dsports/mono.m3u8?token=44a2ff8b3b29eb16e76c06d38cc8d0d1d05e575c-b6-1778198102-1778180102";
    const video = document.getElementById("video");
    const status = document.getElementById("status");

    function showStatus(msg) {
      status.textContent = msg;
      status.style.display = "block";
    }
    function hideStatus() {
      status.style.display = "none";
    }

    if (Hls.isSupported()) {
      const hls = new Hls({ enableWorker: true, lowLatencyMode: false });
      hls.loadSource(src);
      hls.attachMedia(video);
      hls.on(Hls.Events.MANIFEST_PARSED, () => {
        hideStatus();
        video.play().catch(() => {});
      });
      hls.on(Hls.Events.ERROR, (event, data) => {
        if (data.fatal) {
          showStatus("Error al cargar el stream. El enlace puede haber expirado.");
        }
      });
      showStatus("Cargando stream...");
    } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
      video.src = src;
      video.addEventListener("loadedmetadata", () => {
        hideStatus();
        video.play().catch(() => {});
      });
      video.addEventListener("error", () => {
        showStatus("Error al cargar el stream.");
      });
      showStatus("Cargando stream...");
    } else {
      showStatus("Tu navegador no soporta reproducción HLS.");
    }
  </script>
</body>
</html>
